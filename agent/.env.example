# Dev-only, non-secret config. Copy to .env (git-ignored) and run:
#   uv run --env-file .env productivity-agent
# Secrets never go here: the Gemini API key is entered in the app's Settings and stored in the
# OS keychain.

# mock (default, no cloud credentials) | gemini (Gemini API; add your key in Settings)
LLM_PROVIDER=mock

# Only needed when LLM_PROVIDER=gemini. A current Gemini model ID, e.g. from AI Studio.
LLM_MODEL_ID=

# DEBUG | INFO | WARNING | ERROR (logs go to stderr)
LOG_LEVEL=INFO
