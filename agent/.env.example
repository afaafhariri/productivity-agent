# Dev-only, non-secret config. Copy to .env (git-ignored) and run:
#   uv run --env-file .env productivity-agent
# Secrets never go here: they are stored via the SecretStore (OS keychain).

# mock (default, no cloud credentials) | agent_platform (Gemini Enterprise Agent Platform;
# the old value `vertex` still works)
LLM_PROVIDER=mock

# Only needed when LLM_PROVIDER=agent_platform. Pick a current Gemini model in
# Gemini Enterprise Agent Platform Model Garden.
LLM_MODEL_ID=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# DEBUG | INFO | WARNING | ERROR (logs go to stderr)
LOG_LEVEL=INFO
