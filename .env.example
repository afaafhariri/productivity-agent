# Dev-only, non-secret config. Copy to .env (git-ignored) and fill in.
# Secrets never go here: they are stored via the SecretStore (safeStorage).

# mock (default, no cloud credentials) | vertex
LLM_PROVIDER=mock

# Only needed when LLM_PROVIDER=vertex. Pick a current model from the Vertex model list.
LLM_MODEL_ID=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
