# Dev-only, non-secret config. Copy to .env (git-ignored); debug builds (`cargo run`) read it.
# Secrets never go here: API keys and tokens are entered in the app's Settings and stored in
# the OS keychain.

# mock (default, offline demo) | gemini (Gemini API; add your key in Settings)
LLM_PROVIDER=mock

# Only needed when LLM_PROVIDER=gemini. A current Gemini model ID, e.g. from AI Studio.
LLM_MODEL_ID=

# Log detail on stderr, e.g. info, debug, agent_core=debug
RUST_LOG=info
