# Dev-only, non-secret config. Copy to .env (git-ignored); `npm run dev` reads it.
# Secrets never go here: API keys and tokens are entered in the app's Settings and stored
# encrypted with the OS keychain.

# mock (default, offline demo) | gemini (Gemini API; add your key in Settings)
LLM_PROVIDER=mock

# Only needed when LLM_PROVIDER=gemini. A current Gemini model ID, e.g. from AI Studio.
LLM_MODEL_ID=

# Set to debug for more detail on stderr.
LOG_LEVEL=info
